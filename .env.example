# Copy to .env (gitignored). Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# Optional override of the DuckDB file location
# CENSUS_DUCKDB_PATH=data/census.duckdb

# Florida census globe language-model adapter.
# Leave these unset. The globe then answers from governed metrics and reports the
# adapter as disabled. It does not call a model and it does not invent a provider.
# The local LLM Lab's URL, protocol, and model were not available in this repo.
# Do not commit a filled-in .env. If you create .env, restrict it to mode 600.
# A live call is attempted only when ALL of the following are set:
#   CENSUS_LLM_ENABLED=1
#   CENSUS_LLM_LAB_PROTOCOL=ollama_chat
#   CENSUS_LLM_LAB_URL=http://127.0.0.1:11434
#   CENSUS_LLM_LAB_MODEL=
# ollama_chat speaks Ollama's local /api/chat JSON. That shape is NOT confirmed
# as the LLM Lab contract. CENSUS_LLM_TIMEOUT_S defaults to 20.
# CENSUS_LLM_LAB_PROTOCOL=mock is a deterministic test transport, not a model.
